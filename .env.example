# === MQTT Configuration ===
# Public Meshtastic MQTT broker or your own — e.g. mqtt.meshtastic.org
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_USER=your_mqtt_user
MQTT_PASS=your_mqtt_password
MQTT_TOPICS=msh/US/2/e/#

# === Meshtastic Encryption ===
# Default Meshtastic public channel key. Override if your mesh uses a custom PSK.
MESH_KEY=1PG7OiApB1nwvP+rz05pAQ==

# === Discord Bot ===
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
# Channel ID for anomaly alerts (right-click channel -> Copy Channel ID)
DISCORD_ALERT_CHANNEL_ID=0
# Optional: Guild/server ID for faster slash command sync during development
DISCORD_GUILD_ID=
# Set to false to silence black hole detection alerts (they can be noisy)
DISCORD_BLACKHOLE_ALERTS=true
# Set to false to silence router-offline alerts (ROUTER/ROUTER_CLIENT/ROUTER_LATE nodes gone quiet)
DISCORD_ROUTER_OFFLINE_ALERTS=true
# Hours of silence before a router is flagged offline
ROUTER_OFFLINE_HOURS=6
# How often (seconds) to check for offline routers
ROUTER_OFFLINE_CHECK_SEC=600
# Set to false to silence proactive router health warnings (battery/voltage/signal trends)
DISCORD_ROUTER_HEALTH_ALERTS=true
# How often (seconds) to run router health checks
ROUTER_HEALTH_CHECK_SEC=1800
# Flag a router if battery drops this many points within ROUTER_BATTERY_WINDOW_HOURS
ROUTER_BATTERY_DRAIN_PCT=20.0
ROUTER_BATTERY_WINDOW_HOURS=24
# Flag a router if battery readings swing (stddev) by this many points instead of draining smoothly
ROUTER_BATTERY_JITTER_STDDEV=10.0
# Flag a router whose latest voltage reading is below this
ROUTER_BATTERY_VOLTAGE_SAG=3.4
# Flag a router if recent aggregate link SNR has dropped this many dB below its own baseline
ROUTER_SNR_DROP_DB=6.0
ROUTER_SNR_BASELINE_DAYS=14
ROUTER_SNR_RECENT_HOURS=24
ROUTER_SNR_MIN_BASELINE_OBS=20
ROUTER_SNR_MIN_RECENT_OBS=5
# Hours of silence before a /claim-node'd node triggers a DM to its owner
CLAIMED_NODE_OFFLINE_HOURS=24
# How often (seconds) to sweep claimed nodes for offline status
CLAIMED_NODE_CHECK_SEC=900
# How often (seconds) to check for claim-purge notices (claimed node deleted by maintenance)
CLAIM_PURGE_NOTICE_CHECK_SEC=900

# === Web Dashboard ===
WEB_HOST=0.0.0.0
WEB_PORT=5000
# Public URL for links in Discord embeds (your server's public address)
WEB_BASE_URL=http://localhost:5000

# Shared secret that gates every HTTP request via Flask before_request hook. Generate with: openssl rand -hex 32
PROXY_SECRET=

# === Mesh Center Coordinates ===
# Used for weather data fetching and region filtering — set to your mesh network's approximate center
MESH_CENTER_LAT=41.0
MESH_CENTER_LON=-75.9
# Position reports further than this from the center are dropped at ingest; out-of-region nodes already in the DB are purged hourly
MESH_REGION_RADIUS_KM=200
# Position reports above this altitude (meters) are flagged airborne — excluded from the map and shadow/coverage calculations, kept for historic lookup
AIRBORNE_ALTITUDE_M=2000

# === Weather ===
# Polling interval in seconds (default: 900 = 15 minutes)
WEATHER_INTERVAL_SEC=900

# === Shadow Analysis Grid ===
GRID_CELL_SIZE_M=100
GRID_PADDING_KM=2.0
MAX_NODE_RANGE_KM=15.0
COVERAGE_RECALC_SEC=600
SHADOW_THRESHOLD=0.6
MIN_DEAD_ZONE_CELLS=5

# === Elevation API ===
ELEVATION_API_URL=https://api.opentopodata.org/v1/srtm90m
ELEVATION_BATCH_SIZE=100
ELEVATION_RATE_LIMIT_SEC=1.0

# === Coverage Snapshots ===
SNAPSHOT_INTERVAL_SEC=3600

# === Anomaly Detection ===
ANOMALY_CHECK_INTERVAL_SEC=300
ANOMALY_SNR_STDDEV=2.0
ANOMALY_MIN_OBS=20
ANOMALY_LOST_LINK_HOURS=6

# === Channel Utilization Alerts ===
# Alert when a node's avg channel util exceeds this percent over the last hour
CHANNEL_UTIL_THRESHOLD=40.0
# Hours between repeat alerts for the same node
CHANNEL_UTIL_COOLDOWN_HOURS=6

# === Shadow Alert Quiet Hours ===
# Only send shadow alerts between these hours (24h local time)
SHADOW_ALERT_START_HOUR=9
SHADOW_ALERT_END_HOUR=17
# Minimum minutes between shadow alert sends
SHADOW_ALERT_COOLDOWN_MIN=30

# === Daily Digest ===
# Hour (24h local time) to send the daily summary embed
DISCORD_DIGEST_HOUR=8

# === Node Retention ===
# Window (hours) a node counts as "active" on the dashboard
NODE_ACTIVE_HOURS=48
# Nodes not heard from in this many days are deleted and hidden from the map/shadow map
STALE_NODE_DAYS=7

# === Logging ===
LOG_LEVEL=INFO
